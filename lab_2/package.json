{
  "name": "lab_2",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "external": "json-server db.json --port 3001",
    "migrate": "node --env-file=.env src/migrations/migrate.js",
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "seed:force": "node --env-file=.env src/scripts/seed.js force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "imports": {
    "#schemas/*": "./schemas/*",
    "#routes/*": "./routes/*",
    "#controllers/*": "./controllers/*",
    "#services/*": "./services/*",
    "#repositories/*": "./repositories/*",
    "#constants/*": "./constants/*",
    "#utils/*": "./utils/*",
    "#models/*": "./src/models/*",
    "#scripts/*": "./src/scripts/*",
    "#migrations/*": "./src/migrations/*",
    "#events/*": "./src/events/*",
    "#transforms/*": "./src/transforms/*",
    "#db/*": "./db/*"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/env": "^5.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "json-server": "^1.0.0-beta.15",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "vitest": "^4.1.6"
  }
}
