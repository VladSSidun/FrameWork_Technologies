{
  "name": "lab_2",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#schemas/*": "./schemas/*",
    "#routes/*": "./routes/*",
    "#controllers/*": "./controllers/*",
    "#services/*": "./services/*",
    "#repositories/*": "./repositories/*",
    "#constants/*": "./constants/*",
    "#utils/*": "./utils/*"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/env": "^5.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.0.0"
  }
}
